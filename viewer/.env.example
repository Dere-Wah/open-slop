# The same LiveKit project the projector broadcasts into. The server mints
# subscribe-plus-chat tokens from these; the secret never reaches the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the projector's LIVEKIT_ROOM.
LIVEKIT_ROOM=open-slop

# Origins allowed to call /api/infinite/token (The Infinite's theatre). Comma
# separated; unset means theinfinite.tv, www.theinfinite.tv, and
# http://localhost:5187 for their tests.
# INFINITE_ALLOWED_ORIGINS=https://theinfinite.tv,https://www.theinfinite.tv,http://localhost:5187
