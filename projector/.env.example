# ---------------------------------------------------------------- Reactor ---
# The API key the projector drives the model with (rk_... from
# https://www.reactor.inc/account/api-keys). The projector keeps trying to
# connect in a loop; while the model is at capacity or unreachable, the
# broadcast holds the last frame and reconnects in the background.
REACTOR_API_KEY=
# The model to drive. reactor/fast-h3 renders one clip per scene, at the seed
# and length the scene names, and chains continued scenes into one take.
REACTOR_MODEL=reactor/fast-h3

# ---------------------------------------------------------------- LiveKit ---
# The room the show is broadcast into. The projector creates the room, is its
# only media publisher, writes the rundown into the room's metadata, and reads
# viewer chat. The viewer app must point at the same LiveKit project and room.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=open-slop

# ------------------------------------------------------------------ Story ---
# Where the screenplay lives. STORY_REPO is a git URL or a local path holding
# the story branch; the projector keeps a blobless partial-clone mirror of it
# and snapshots the branch tip once per screening, about a minute before that
# screening starts (see screening.py, PREROLL_SECONDS). For public production
# this is the GitHub URL; for offline iteration it can be a local clone path.
STORY_REPO=https://github.com/Dere-Wah/open-slop.git
STORY_BRANCH=story
# Where the local mirror is kept (created on first run).
# STORY_MIRROR_DIR=~/.cache/open-slop/story
# The browse URL used to build commit/file links shown to viewers. Defaults to
# the story repo when it is an https GitHub URL, else the project URL.
# STORY_HTML_URL=https://github.com/Dere-Wah/open-slop
# Optional. Credits resolve each commit to its GitHub login through the commits
# API (60 requests/hour anonymous, 5000 with a token; answers are cached beside
# the mirror). A fine-grained token with no permissions is enough.
# GITHUB_TOKEN=
